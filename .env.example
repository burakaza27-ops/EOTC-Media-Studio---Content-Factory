# ═══════════════════════════════════════════════════════════════
# ✝️ EOTC MEDIA STUDIO v7.0 — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# AI Configuration (REQUIRED for AI generation)
# ─────────────────────────────────────────────────────────────
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Primary Model selection
# Recommended: google/gemini-2.5-flash, google/gemini-2.5-flash-lite
AI_MODEL=google/gemini-2.5-flash

# ─────────────────────────────────────────────────────────────
# Video Reel Rendering Engine (FFmpeg)
# ─────────────────────────────────────────────────────────────
# Set to 'true' to automatically generate animated MP4 reels with Ken Burns motion
GENERATE_VIDEO=false

# Video Aspect Ratios (comma-separated: 1:1, 4:5, 9:16)
# 1:1  = 1080x1080 (Telegram / Facebook)
# 4:5  = 1080x1350 (Instagram Feed)
# 9:16 = 1080x1920 (YouTube Shorts / TikTok / Reels)
VIDEO_PROFILES=1:1,9:16

# Optional custom FFmpeg binary path (if not in PATH or ffmpeg-installer)
FFMPEG_PATH=

# ─────────────────────────────────────────────────────────────
# Web Studio GUI Server
# ─────────────────────────────────────────────────────────────
# Port for the local Web Studio interface (npm run studio)
STUDIO_PORT=3333

# ─────────────────────────────────────────────────────────────
# Telegram Broadcast & Concierge Bot
# ─────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Default channel/group ID for automated daily drops (e.g., -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=-1001234567890

# ─────────────────────────────────────────────────────────────
# Supabase Configuration (OPTIONAL - for duplicate prevention)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ...
SUPABASE_TABLE=quotes

# ─────────────────────────────────────────────────────────────
# Puppeteer Configuration (auto-detected)
# ─────────────────────────────────────────────────────────────
# For GitHub Actions: PUPPETEER_EXEC_PATH=/usr/bin/google-chrome
# For local: leave empty (auto-detect)
PUPPETEER_EXEC_PATH=

# ─────────────────────────────────────────────────────────────
# Pipeline Defaults
# ─────────────────────────────────────────────────────────────
# Content type: quote, verse, carousel, reflection, saint, fasting, holyweek, history, calendar, all
CONTENT_TYPE=quote

# Use liturgical calendar intelligence (Bahire Hasab computus)
USE_LITURGICAL=true

# Logging Level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
VERBOSE_ERRORS=true